# Copia este fichero a .env.local (dev) y ajusta los valores.
# En producción estas variables las define compose.prod.yaml a partir del
# .env real (no versionado) del servidor.

# Secreto de firma de la cookie de sesión (iron-session). Debe tener al
# menos 32 caracteres. Genera uno nuevo con: openssl rand -base64 32
SESSION_SECRET=

# URL interna donde el servidor Next.js alcanza a la API de Symfony.
# Dev:  http://localhost:8000
# Prod: http://api:80 (nombre del servicio en compose.prod.yaml, dentro de
#       la red Docker del proyecto — la API no se expone públicamente)
API_URL=http://localhost:8000
